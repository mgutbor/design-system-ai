# AI configuration — used by apps/api (F7/F5). Never commit a real .env file;
# copy this file to .env and fill in values. The API key lives ONLY server-side.

# Provider implementation: 'mock' (default, offline/deterministic, no key) | 'nvidia'
AI_PROVIDER=mock

# --- NvidiaProvider (only needed when AI_PROVIDER=nvidia) --------------------
# Backend: NVIDIA Build (build.nvidia.com) — free tier, OpenAI-compatible.
# API key generated at build.nvidia.com (free account). Never in browser/repo/logs.
NVIDIA_API_KEY=

# Model identifier. No default in code (model = configuration, never part of
# ai-core). Verified value in the NVIDIA API catalog:
#   deepseek-ai/deepseek-v4-flash-0731   (DeepSeek V4 Flash 07/31, hosted by NVIDIA)
# Change it freely without touching ai-core (any model from the NVIDIA catalog).
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731

# Optional: override the provider base URL. Default: https://integrate.api.nvidia.com/v1
# (NVIDIA Build OpenAI-compatible endpoint).
NVIDIA_BASE_URL=

# Optional: request timeout in ms (default 30000, SPEC §7).
# NVIDIA_TIMEOUT_MS=
