# AI configuration — used by apps/api (F7/F5). Never commit a real .env file;
# copy this file to .env and fill in values. The API key lives ONLY server-side.

# Provider implementation: 'mock' (default, offline/deterministic, no key) | 'nvidia'
AI_PROVIDER=mock

# --- NvidiaProvider (only needed when AI_PROVIDER=nvidia) --------------------
# Backend: NVIDIA Build (build.nvidia.com) — free tier, OpenAI-compatible.
# API key generated at build.nvidia.com (free account). Never in browser/repo/logs.
NVIDIA_API_KEY=

# Model identifier. No default in code (model = configuration, never part of
# ai-core). Verified value in the NVIDIA API catalog:
#   deepseek-ai/deepseek-v4-flash-0731   (DeepSeek V4 Flash 07/31, hosted by NVIDIA)
# Change it freely without touching ai-core (any model from the NVIDIA catalog).
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731

# Optional: override the provider base URL. Default: https://integrate.api.nvidia.com/v1
# (NVIDIA Build OpenAI-compatible endpoint).
NVIDIA_BASE_URL=

# Optional: request timeout in ms (default 60000 — latencia real observada
# 8.5–25.3 s por respuesta grounded; SPEC §7).
# NVIDIA_TIMEOUT_MS=

# --- apps/api runtime (V1 FINAL) --------------------------------------------

# Rate limiting (en memoria, una sola instancia). Max por ventana por IP;
# RATE_LIMIT_MAX=0 lo desactiva. Default: 60 req/min.
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_MS=60000

# CORS en producción: lista separada por comas de orígenes permitidos (el
# dominio público de apps/docs). Si NO se define, el default de desarrollo
# permite cualquier origen (Access-Control-Allow-Origin: *).
# CORS_ORIGIN=https://docs.example.com

# TRUST_PROXY=1 SOLO detrás de un proxy de confianza que sobrescribe
# X-Forwarded-For (p. ej. Vercel/Fly). Sin él, la IP del rate limit se toma
# de la dirección del socket y X-Forwarded-For enviado por el cliente NO se
# confía (anti-spoofing).
# TRUST_PROXY=1

# Puerto HTTP (default 3001).
# PORT=3001

# --- apps/docs build-time (públicas) ---------------------------------------

# Origen de la API del asistente desde el navegador. OBLIGATORIA en el build
# de producción; si se omite, la UI usa http://localhost:3001 (solo dev).
# Las variables VITE_* son públicas y viajan al bundle — nunca pongas
# secretos aquí.
# VITE_API_BASE_URL=https://api.example.com
