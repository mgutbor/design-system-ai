{
  "name": "@ods-ai/ai-providers",
  "version": "0.0.0",
  "private": true,
  "description": "Concrete AI providers for Open Design System AI. MockProvider (deterministic, offline, no API key) + NvidiaProvider (NVIDIA Build, free tier, OpenAI-compatible).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run packages/ai-providers"
  },
  "dependencies": {
    "@ods-ai/ai-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
