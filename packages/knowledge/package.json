{
  "name": "@ods-ai/knowledge",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic knowledge layer and retriever for Open Design System AI. Consumes component metadata and builds a searchable corpus without any LLM dependency.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
