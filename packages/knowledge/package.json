    "test": "vitest run packages/knowledge"
  },
  "dependencies": {
    "@ods-ai/react": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
