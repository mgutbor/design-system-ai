{
  "name": "@ods-ai/react",
  "version": "0.1.0",
  "private": false,
  "description": "Accesibles React components for Open Design System AI (WCAG 2.2 AA): Button, Input, FormField, Checkbox, Select, Modal, Badge, Spinner.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata/index.json",
      "default": "./dist/metadata/index.json"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "design-system",
    "react",
    "accessibility",
    "wcag",
    "typescript"
  ],
  "scripts": {
    "metadata": "vite-node src/scripts/generate-metadata.ts",
    "build": "pnpm metadata && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run packages/react",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@ods-ai/tokens": "workspace:*",
    "@storybook/react-vite": "^10.5.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
