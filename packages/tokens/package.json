{
  "name": "@ods-ai/tokens",
  "version": "0.1.0",
  "private": false,
  "description": "Design tokens for Open Design System AI: primitive, semantic and theme layers with generated CSS and TypeScript.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgutbor/design-system-ai.git"
  },
  "main": "./dist/tokens.mjs",
  "module": "./dist/tokens.mjs",
  "types": "./dist/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.mjs"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "css-variables",
    "theming"
  ],
  "scripts": {
    "generate": "tsx src/scripts/generate.ts",
    "validate": "tsx src/scripts/validate.ts",
    "build": "pnpm generate && pnpm validate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run packages/tokens",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
